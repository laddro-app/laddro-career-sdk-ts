{
  "name": "@laddro/career-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Laddro Career API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "eslint src",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "laddro",
    "career",
    "resume",
    "cover-letter",
    "api",
    "sdk"
  ],
  "author": "Laddro <support@laddro.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/laddro-app/laddro-career-sdk-ts"
  },
  "homepage": "https://developers.laddro.com",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "eslint": "^9.0.0"
  }
}
